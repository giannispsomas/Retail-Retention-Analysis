{
  "name": "Retail E-commerce",
  "dataColors": [
    "#0F4C5C",
    "#E36414",
    "#2A9D8F",
    "#9A031E",
    "#FB8B24",
    "#5F0F40",
    "#7F7F7F",
    "#8AB0AB"
  ],
  "background": "#FFFFFF",
  "foreground": "#262626",
  "tableAccent": "#0F4C5C",
  "good": "#2A9D8F",
  "neutral": "#FB8B24",
  "bad": "#9A031E",
  "maximum": "#0F4C5C",
  "center": "#F1E3D3",
  "minimum": "#F5C9B8",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0F4C5C"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#595959"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#0F4C5C"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#0F4C5C"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "alignment": "left",
            "fontSize": 12,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#0F4C5C"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "radius": 8,
            "color": {
              "solid": {
                "color": "#D9C9B4"
              }
            }
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#595959"
              }
            },
            "fontSize": 10,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#595959"
              }
            },
            "fontSize": 10,
            "showAxisTitle": false
          }
        ],
        "gridlines": [
          {
            "color": {
              "solid": {
                "color": "#ECEFF4"
              }
            },
            "strokeWidth": 1
          }
        ],
        "legend": [
          {
            "position": "Top",
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#595959"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EADFCF"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}